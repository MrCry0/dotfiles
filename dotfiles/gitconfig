[alias]
    l = log --graph --pretty=format:'%C(auto)%h%C(auto)%d %s %C(dim white)(%aN, %ar)'
    c = log -n 1 --pretty='%h (\"%s\")'
    cis = commit -S
    cu = log -n 1 --pretty="format:%h;%ai;;;;;;;%s%n"
    cul = log --pretty="format:%h;%ai;;%s"
    logs = log --show-signature
    wdiff = diff --color-words
[blame]
    # date = relative
[color]
    ui = true
    branch = always
    diff = true
    interactive = always
    grep = true
    pager = true
    decorate = always
    showbranch = always
[checkout]
    defaultRemote = upstream
[core]
    excludesfile = ~/.gitexcludes
    autocrlf = false
[diff]
    algorithm = histogram
    compactionHeuristic = true
[http]
    cookiefile = ~/.gitcookies
    version = HTTP/1.1
[merge]
    tool = vimdiff
    # ff = only
[push]
    default = tracking
[pull]
    ff = only
[rerere]
    enabled = true
    autoupdate = true
[rebase]
    stat = true
[url "git@github.com:MrCry0/"]

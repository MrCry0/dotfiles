[includeIf "gitdir/i:~/work/"]
    path = /home/cryo/.gitconfig-work

[includeIf "gitdir/i:~/src/"]
    path = /home/cryo/.gitconfig-cryo
[color]
    ui = true
    branch = always
    diff = true
    interactive = always
    grep = true
    pager = true
    decorate = always
    showbranch = always
[url "git@github.com:MrCry0/"]
    insteadOf = github:
[core]
    excludesfile = ~/.gitexcludes
    autocrlf = false
	editor = vim
	hooksPath = .githooks
[merge]
    tool = vimdiff
    ff = only
[push]
	default = tracking
[diff]
    algorithm = histogram
    compactionHeuristic = true
    noprefix = true
[rerere]
    enabled = true
    autoupdate = true
[rebase]
    stat = true
[alias]
    l = log --graph --color --pretty=format:'%C(bold yellow) %C(reset) %C(red)%h%C(reset) -%C(yellow)%d%C(reset) %s %C(green)(%cr) %C(blue)<%an>%C(reset)'
    wdiff = diff --color-words
    lg = "!f() { \
        RESET=$(tput sgr0); \
        BOLD=$(tput5 bold); \
        RED=$(tput setaf 1); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); \
        BOLDRED=\"${BOLD}${RED}\"; BOLDGREEN=\"${BOLD}${GREEN}\"; BOLDYELLOW=\"${BOLD}${YELLOW}\"; \
        LG_FORMAT='<sig>%G?</sig> %C(red)%h%C(reset) -%C(yellow)%d%C(reset) %s %C(green)(%cr) %C(blue)<%an>%C(reset)'; \
        echo FMT=\"$LG_FORMAT\"; \
        git log --color --graph --pretty=format:\"${LG_FORMAT}\" | \
            sed \
                -e \"s#<sig>G</sig>#${BOLDGREEN}Good${RESET}#; \
                     s#<sig>B</sig>#${BOLDRED}\\nBAD \\nBAD \\nBAD \\nBAD \\nBAD${RESET}#; \
                     s#<sig>U</sig>#${YELLOW}Unknown${RESET}#; \
                     s#<sig>X</sig>#${YELLOW}Expired${RESET}#; \
                     s#<sig>Y</sig>#${YELLOW}Expired Key${RESET}#; \
                     s#<sig>R</sig>#${BOLDRED}Revoked${RESET}#; \
                     s#<sig>E</sig>#${RED}Missing Key${RESET}#; \
                     s#<sig>N</sig>#${BOLDYELLOW}None${RESET}#\" | \
            less -r; \
    }; f"
	c = log --pretty=format:'%h (\"%s\")' -n 1
[http]

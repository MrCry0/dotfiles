[user]
    name = Oleksandr Suvorov
    email = cryosay@gmail.com
	signingkey = 21317A636DA16768
[alias]
    l = log --graph --pretty=format:'%C(auto)%h%C(auto)%d %s %C(dim white)(%aN, %ar)'
    c = log -n 1 --pretty='%h (\"%s\")'
    cis = commit -S
    cu = log -n 1 --pretty="format:%h;%ai;;;;;;;%s%n"
    cul = log --pretty="format:%h;%ai;;%s"
    logs = log --show-signature
    wdiff = diff --color-words
[blame]
    # date = relative
[color]
    ui = true
    branch = always
    diff = true
    interactive = always
    grep = true
    pager = true
    decorate = always
    showbranch = always
[checkout]
    defaultRemote = upstream
[core]
    excludesfile = ~/.gitexcludes
    autocrlf = false
	compression = 0
[diff]
    algorithm = histogram
    compactionHeuristic = true
[http]
    cookiefile = ~/.gitcookies
    version = HTTP/1.1
	postBuffer = 1048576000
	maxRequestBuffer = 100M
[merge]
    tool = vimdiff
[push]
    default = tracking
[pull]
    ff = only
[rerere]
    enabled = true
    autoupdate = true
[rebase]
    stat = true
[sendemail]
    confirm = auto
    smtpencryption = tls
    from = Oleksandr Suvorov <cryosay@gmail.com>
    smtpuser = cryosay@gmail.com
    chainreplyto = true
    smtpserver = smtp.gmail.com
    # smtpserver = "/usr/bin/msmtp"
    smtpserverport = 587
    smtppass =
[commit]
	gpgsign = true

[user]
    name = Oleksandr Suvorov
    email = cryosay@gmail.com
[color]
    ui = true
    branch = always
    diff = true
    interactive = always
    grep = true
    pager = true
    decorate = always
    showbranch = always
[url "git@github.com:MrCry0/"]
    insteadOf = github:
[core]
    excludesfile = ~/.gitexcludes
    autocrlf = false
	editor = vim
[merge]
    tool = vimdiff
    ff = only
[push]
	default = tracking
[diff]
    algorithm = histogram
    compactionHeuristic = true
    noprefix = true
[rerere]
    enabled = true
    autoupdate = true
[rebase]
    stat = true
[alias]
    wdiff = diff --color-words
    lg = "!f() { \
        git log --all --color --graph --pretty=format:'%C(bold yellow)<sig>%G?</sig>%C(reset) %C(red)%h%C(reset) -%C(yellow)%d%C(reset) %s %C(green)(%cr) %C(blue)<%an>%C(reset)' | \
        sed \
        -e 's#<sig>G</sig>#Good#' \
        -e 's#<sig>B</sig>#\\nBAD \\nBAD \\nBAD \\nBAD \\nBAD#' \
        -e 's#<sig>U</sig>#Unknown#' \
        -e 's#<sig>X</sig>#Expired#' \
        -e 's#<sig>Y</sig>#Expired Key#' \
        -e 's#<sig>R</sig>#Revoked#' \
        -e 's#<sig>E</sig>#Missing Key#' \
        -e 's#<sig>N</sig>#None#' | \
        less -r; \
    }; f"
[http]
    cookiefile = ~/.gitcookies
[blame]
#    date = relative
